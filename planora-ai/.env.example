# Optional Gemini API key for model-backed conversation.
# Without a key, Planora uses its local planning assistant and tools.
GOOGLE_API_KEY=
MODEL_NAME=gemini-flash-latest

# Optional: set a custom location for the local SQLite database.
# PLANORA_DB_PATH=./data/planora.db

ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
