{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "planora-ai": {
      "root": "planora-ai",
      "framework": "fastapi",
      "entrypoint": "index:app"
    },
    "frontend": {
      "root": "planora-ai/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "planora-ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}